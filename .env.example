# Copy to .env.local and fill in. Real values never go in git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (sb_secret_...)
SUPABASE_SECRET_KEY=

# Local preview only: show draft products (never used in production)
PREVIEW_DRAFTS=
# Public site URL (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: set to https://firuza.es once the domain is bought
# Order emails via Resend. Without RESEND_API_KEY + EMAIL_FROM emails are only logged to the console (orders never fail because of mail).
RESEND_API_KEY=
# e.g. Firuza <pedidos@firuza.es> (the domain must be verified in Resend)
EMAIL_FROM=
# where new-order and contact notifications go
OWNER_EMAIL=

# Stripe (TEST keys only until launch). Hosted Checkout + webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true ONLY when the Stripe account has the Bizum capability active (default: card only)
STRIPE_BIZUM_ENABLED=

# Hidden launch lock: SITE_LOCK=1 puts HTTP Basic Auth on the whole site (webhook, robots.txt and static files excepted), adds X-Robots-Tag noindex and robots.txt Disallow: /.
# Set SITE_LOCK=0 (or remove it) to go public.
SITE_LOCK=
SITE_LOCK_USER=
SITE_LOCK_PASSWORD=
